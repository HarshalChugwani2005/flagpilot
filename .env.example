# Copy to .env and fill in. Never commit .env.

# --- LLM: NVIDIA NIM (free key at https://build.nvidia.com) ---
NVIDIA_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Reasoning models think before answering; 4096 leaves room for the answer
LLM_MAX_TOKENS=4096
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# 1 = cache LLM responses on disk (recommended in development)
LLM_CACHE=1

# --- Flagsmith ---
# Organisation API key: Flagsmith dashboard > Organisation Settings > API Keys
FLAGSMITH_ADMIN_API_KEY=
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1/
# Numeric project id (visible in the dashboard URL: /project/<id>/...)
FLAGSMITH_PROJECT_ID=
# Client-side environment key: Environment > SDK Keys
FLAGSMITH_ENVIRONMENT_KEY=
# Optional server-side key (Environment > SDK Keys > Server-side, starts ser.) for the
# traffic simulator's Python SDK. Falls back to FLAGSMITH_ENVIRONMENT_KEY if empty.
FLAGSMITH_SERVER_KEY=
# Dashboard base URL, used for "Open in Flagsmith" links
FLAGSMITH_APP_URL=https://app.flagsmith.com

# --- Time saved ---
# Minutes it takes YOU to set up the same experiment by hand in the Flagsmith dashboard
# (decimals allowed, e.g. 7.5). Time it once and enter it here. FlagPilot records its
# own planning + applying seconds in the audit log ("timed" entries); your review time
# is shown separately and not counted. Leave empty to hide the number.
MANUAL_BASELINE_MINUTES=

# --- Demo store ---
# Flag the demo store and simulator use. Leave empty to use the experiment FlagPilot
# most recently made live. Its JSON value ({"color": "#16a34a", "label": "Buy now"})
# styles the store's button.
STORE_FLAG_NAME=

# --- Safety ---
# 1 = plans may target production (still needs human approval). Keep 0 for the demo.
ALLOW_PRODUCTION=0
# 1 = the executor logs the Flagsmith calls it would make but sends none (UI default)
DRY_RUN=0

# --- Simulation ---
# Keep small on the free tier (50K requests/month)
SIM_VISITORS=500
